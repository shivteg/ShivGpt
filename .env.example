# Groq API Key for Text Models (Get your key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Image Generation API Key (Put your Together AI, OpenAI, HuggingFace, or Stability API key here)
# Supported variables: IMAGE_GEN_API_KEY, TOGETHER_API_KEY, OPENAI_API_KEY, HF_TOKEN, STABILITY_API_KEY
IMAGE_GEN_API_KEY=your_image_generation_api_key_here

# Optional specific API key overrides:
TOGETHER_API_KEY=your_together_ai_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
HF_TOKEN=hf_your_huggingface_token_here

# Optional: Default Model (Defaults to llama-3.3-70b-versatile)
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# Groq API Key for Text Models (Get your key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Image Generation API Key (Together AI, OpenAI, HuggingFace, Stability)
TOGETHER_API_KEY=your_together_ai_key_here
IMAGE_GEN_API_KEY=your_image_generation_api_key_here

# Supabase Authentication (Automatically provided when connecting Supabase on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...your_supabase_anon_key_here

# Optional: Default Model (Defaults to llama-3.3-70b-versatile)
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
